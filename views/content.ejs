<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contenido — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'content'}) %><main class="main"><section class="container"><h1>Contenido</h1><p class="muted">Planificá tu calendario de publicaciones.</p><article class="panel"><form method="post" action="/content"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><label>Título<input name="title" required></label><label>Tipo<select name="type"><option>Post</option><option>Story</option><option>Reel</option><option>Video</option></select></label><label>Plataforma<select name="platform"><option>Instagram</option><option>Facebook</option><option>TikTok</option></select></label><label>Fecha<input type="date" name="scheduled_date"></label></div><label>Copy<textarea name="copy"></textarea></label><button>Agregar</button></form></article><article class="panel"><table><thead><tr><th>Fecha</th><th>Título</th><th>Tipo</th><th>Plataforma</th><th>Estado</th><th></th></tr></thead><tbody><%content.forEach(x=>{%><tr><td><%=x.scheduled_date||'—'%></td><td><%=x.title%></td><td><%=x.type%></td><td><%=x.platform%></td><td><%=x.status%></td><td><form method="post" action="/content/<%=x.id%>/delete"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="danger">Eliminar</button></form></td></tr><%})%></tbody></table></article></section></main></div></body></html>