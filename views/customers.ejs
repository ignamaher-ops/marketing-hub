<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Clientes — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'customers'}) %><main class="main"><section class="container"><h1>Clientes</h1><p class="muted">CRM de tu negocio.</p><article class="panel"><form method="post" action="/customers"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><label>Nombre<input name="name" required></label><label>Teléfono<input name="phone"></label><label>Email<input type="email" name="email"></label><label>Estado<select name="status"><option value="new">Nuevo</option><option value="frequent">Frecuente</option><option value="inactive">Inactivo</option></select></label></div><button>Agregar cliente</button></form></article><article class="panel"><h2>Base de clientes</h2><table><thead><tr><th>Cliente</th><th>Teléfono</th><th>Estado</th><th>Compras</th><th>Total</th><th>Última compra</th></tr></thead><tbody><%customers.forEach(c=>{%><tr><td><%=c.name%><br><small><%=c.email||''%></small></td><td><%=c.phone||'—'%></td><td><%=c.status%></td><td><%=c.purchases%></td><td>$<%=Number(c.total_spent).toLocaleString('es-AR')%></td><td><%=c.last_purchase||'—'%></td></tr><%})%></tbody></table></article></section></main></div></body></html>