<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Promociones — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'promotions'}) %><main class="main"><section class="container"><h1>Promociones</h1><p class="muted">Creá ofertas y códigos para tu negocio.</p><article class="panel"><form method="post" action="/promotions"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><label>Nombre<input name="title" required></label><label>Código<input name="code" required></label><label>Descuento<input name="discount" required placeholder="20%"></label><label>Inicio<input type="date" name="start_date"></label><label>Fin<input type="date" name="end_date"></label></div><button>Crear promoción</button></form></article><article class="panel"><table><thead><tr><th>Promoción</th><th>Código</th><th>Descuento</th><th>Vigencia</th><th>Usos</th></tr></thead><tbody><%promotions.forEach(p=>{%><tr><td><%=p.title%></td><td><%=p.code%></td><td><%=p.discount%></td><td><%=p.start_date||'—'%> → <%=p.end_date||'—'%></td><td><%=p.uses%></td></tr><%})%></tbody></table></article></section></main></div></body></html>