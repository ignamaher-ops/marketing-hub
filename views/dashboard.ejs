<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><div class="app"><aside><div class="logo">Marketing<span>Hub</span></div><nav><a class="active" href="/dashboard">Dashboard</a><a href="/campaigns">Publicidad</a><a href="/content">Contenido</a><a href="/customers">Clientes</a><a href="/reviews">Reseñas</a><a href="/promotions">Promociones</a><a href="/settings">Configuración</a></nav><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="ghost">Cerrar sesión</button></form></aside><main class="main"><header><strong><%=biz.name%></strong><span><%=user.email%></span></header><section class="container"><div class="page-title"><div><h1>Hola, <%=user.name%></h1><p class="muted">Resumen de tu marketing.</p></div><a class="button" href="/campaigns">+ Nueva campaña</a></div><div class="cards"><article><small>Inversión</small><strong>$<%=Math.round(Number(totals.spent)).toLocaleString('es-AR')%></strong></article><article><small>Consultas</small><strong><%=totals.leads%></strong></article><article><small>Ventas</small><strong><%=totals.sales%></strong></article><article><small>Costo por venta</small><strong>$<%=Math.round(costPerSale).toLocaleString('es-AR')%></strong></article></div><div class="grid"><article class="panel"><h2>Campañas</h2><table><thead><tr><th>Nombre</th><th>Plataforma</th><th>Gastado</th><th>Ventas</th></tr></thead><tbody><%campaigns.forEach(c=>{%><tr><td><%=c.name%></td><td><%=c.platform%></td><td>$<%=Math.round(Number(c.spent)).toLocaleString('es-AR')%></td><td><%=c.sales%></td></tr><%})%></tbody></table></article><article class="panel"><h2>Estado</h2><div class="status"><span>Contenido pendiente</span><b><%=content.filter(x=>['draft','scheduled'].includes(x.status)).length%></b></div><div class="status"><span>Reseñas pendientes</span><b><%=reviews.filter(x=>x.status==='pending').length%></b></div><div class="status"><span>Clientes</span><b><%=customers.length%></b></div><div class="status"><span>Promociones activas</span><b><%=promotions.filter(x=>x.status==='active').length%></b></div></article></div></section></main></div></body></html>