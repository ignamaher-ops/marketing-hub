<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reseñas — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'reviews'}) %><main class="main"><section class="container"><h1>Reseñas</h1><p class="muted">Gestioná la reputación de tu negocio.</p><article class="panel"><%reviews.forEach(r=>{%><div class="review"><strong><%=r.customer_name%></strong><div><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p><%=r.comment||''%></p><%if(r.status==='pending'){%><form method="post" action="/reviews/<%=r.id%>/respond"><input type="hidden" name="_csrf" value="<%=csrf%>"><textarea name="response" required placeholder="Respuesta..."></textarea><button>Responder</button></form><%}else{%><div class="response"><b>Respuesta</b><p><%=r.response%></p></div><%}%></div><%})%></article></section></main></div></body></html>