<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Publicidad — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'campaigns'}) %><main class="main"><section class="container"><h1>Publicidad</h1><p class="muted">Administrá campañas y presupuesto.</p><article class="panel"><form method="post" action="/campaigns"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><label>Nombre<input name="name" required></label><label>Plataforma<select name="platform"><option>Instagram</option><option>Facebook</option><option>Google</option><option>TikTok</option></select></label><label>Objetivo<select name="objective"><option>Conseguir clientes</option><option>Ventas</option><option>Mensajes</option><option>Visitas al local</option></select></label><label>Presupuesto<input type="number" min="0" name="budget" required></label><label>Inicio<input type="date" name="start_date"></label><label>Fin<input type="date" name="end_date"></label></div><button>Crear campaña</button></form></article><article class="panel"><h2>Tus campañas</h2><table><thead><tr><th>Campaña</th><th>Plataforma</th><th>Objetivo</th><th>Presupuesto</th><th>Estado</th><th></th></tr></thead><tbody><%campaigns.forEach(c=>{%><tr><td><%=c.name%></td><td><%=c.platform%></td><td><%=c.objective%></td><td>$<%=Number(c.budget).toLocaleString('es-AR')%></td><td><%=c.status%></td><td><form method="post" action="/campaigns/<%=c.id%>/delete"><input type="hidden" name="_csrf" value="<%=csrf%>"><button class="danger">Eliminar</button></form></td></tr><%})%></tbody></table></article></section></main></div></body></html>