<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Configuración — Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav',{biz,active:'settings'}) %><main class="main"><section class="container"><h1>Configuración</h1><p class="muted">Información de tu empresa.</p><article class="panel"><form method="post" action="/settings"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><label>Nombre<input name="name" value="<%=biz.name%>" required></label><label>Categoría<input name="category" value="<%=biz.category%>" required></label><label>Dirección<input name="address" value="<%=biz.address||''%>"></label><label>Teléfono<input name="phone" value="<%=biz.phone||''%>"></label><label>Instagram<input name="instagram" value="<%=biz.instagram||''%>"></label><label>Presupuesto mensual<input type="number" min="0" name="monthly_budget" value="<%=biz.monthly_budget%>"></label></div><button>Guardar cambios</button></form></article><article class="panel"><h2>Integraciones</h2><p>Meta Ads, Instagram, Google Business, WhatsApp, IA y pagos requieren credenciales y configuración de producción. Esta interfaz no simula conexiones.</p><span class="badge">Pendientes de configurar</span></article></section></main></div></body></html>