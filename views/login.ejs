<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Marketing Hub</title><link rel="stylesheet" href="/styles.css"></head><body><main class="login-page"><section class="login-card"><div class="logo">Marketing<span>Hub</span></div><p class="muted">Gestión de marketing para pequeños negocios.</p><% if(error){%><div class="alert"><%=error%></div><%}%><% if(mode==='register'){%><h1>Crear cuenta</h1><form method="post" action="/register"><input type="hidden" name="_csrf" value="<%=csrf%>"><label>Tu nombre<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Contraseña<input type="password" name="password" minlength="10" required></label><label>Nombre del negocio<input name="business_name" required></label><label>Categoría<input name="category" value="Negocio"></label><button>Crear cuenta</button></form><p class="muted">¿Ya tenés cuenta? <a href="/login">Ingresar</a></p><%}else{%><h1>Ingresar</h1><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%=csrf%>"><label>Email<input type="email" name="email" required></label><label>Contraseña<input type="password" name="password" required></label><button>Ingresar</button></form><p class="muted">¿Es tu primera vez? <a href="/register">Crear cuenta</a></p><%}%></section></main></body></html>